---
interface Props {
  title: string;
  subtitle?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  image?: { src: string; alt: string };
  badge?: string;
  class?: string;
}

const {
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  image,
  badge,
  class: className = '',
} = Astro.props;
---

<section class={`relative section overflow-hidden ${className}`} aria-labelledby="hero-title">
  <div class="container">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left animate-slide-up" style="animation-delay: 100ms;">
        {badge && (
          <span class="inline-block badge-primary mb-6 animate-fade-in" style="animation-delay: 200ms;">
            {badge}
          </span>
        )}
        <h1 id="hero-title" class="text-4xl md:text-5xl lg:text-6xl font-bold text-neutral-900 mb-6 animate-fade-in" style="animation-delay: 300ms;">
          {title}
        </h1>
        {subtitle && (
          <p class="text-lg md:text-xl text-neutral-600 mb-8 max-w-xl mx-auto lg:mx-0 animate-fade-in" style="animation-delay: 400ms;">
            {subtitle}
          </p>
        )}
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 animate-fade-in" style="animation-delay: 500ms;">
          {ctaPrimary && (
            <a href={ctaPrimary.href} class="btn-primary w-full sm:w-auto">
              {ctaPrimary.label}
            </a>
          )}
          {ctaSecondary && (
            <a href={ctaSecondary.href} class="btn-secondary w-full sm:w-auto">
              {ctaSecondary.label}
            </a>
          )}
        </div>
      </div>

      <!-- Image -->
      {image && (
        <div class="relative animate-slide-up" style="animation-delay: 200ms;">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img
              src={image.src}
              alt={image.alt}
              class="w-full h-auto object-cover"
              loading="eager"
            />
            <!-- Decorative accent -->
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary-100 rounded-full opacity-50 blur-3xl" aria-hidden="true" />
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-secondary-100 rounded-full opacity-50 blur-3xl" aria-hidden="true" />
          </div>
          <!-- Floating stats badges -->
          <div class="absolute -bottom-6 left-6 md:left-0 bg-white rounded-xl shadow-lg p-4 md:p-6 min-w-[280px] border border-neutral-200">
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center p-3 bg-primary-50 rounded-lg">
                <p class="text-2xl font-bold text-primary-700">15+</p>
                <p class="text-sm text-neutral-600">Team Members</p>
              </div>
              <div class="text-center p-3 bg-secondary-50 rounded-lg">
                <p class="text-2xl font-bold text-secondary-700">500+</p>
                <p class="text-sm text-neutral-600">Projects Done</p>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- No image fallback - decorative pattern -->
      {!image && (
        <div class="relative h-80 md:h-96 lg:h-[500px] animate-slide-up" style="animation-delay: 200ms;">
          <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-secondary-50 rounded-2xl" aria-hidden="true" />
          <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
            <svg class="w-1/2 h-1/2 max-w-md max-h-md opacity-20 text-primary-600" viewBox="0 0 200 200" fill="none">
              <rect x="20" y="60" width="160" height="120" rx="12" stroke="currentColor" stroke-width="3"/>
              <path d="M20 100L60 140L140 60" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="50" y="70" width="40" height="30" rx="4" stroke="currentColor" stroke-width="2"/>
              <rect x="110" y="70" width="40" height="30" rx="4" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>