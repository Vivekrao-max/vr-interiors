---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
---

<Layout title="Contact VR Interiors - Get a Free Quote" description="Contact VR Interiors for interior design services and premium materials. Visit our showroom at 8-141 Durga Nagar Layout, Pendurthi, Vizag 531173. Call or WhatsApp: 83601314068, 8872038393. Email: vrenterprisesvizag28@gmail.com">
  <Nav currentPage="/contact" slot="header" />

  <!-- Hero -->
  <Section id="contact-hero" background="gradient" padding="xl" narrow>
    <div class="text-center">
      <span class="badge-primary mb-6">Let's Talk</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-neutral-900 mb-6">Ready to Transform Your Space?</h1>
      <p class="text-xl md:text-2xl text-neutral-600 max-w-3xl mx-auto">Get a free consultation, material samples, and a detailed quote. No obligation — just honest advice.</p>
    </div>
  </Section>

  <!-- Contact Form & Info -->
  <Section id="contact-main" background="default" padding="lg">
    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <Card variant="default" padding="lg">
          <h2 class="text-2xl font-bold text-neutral-900 mb-6">Send Us a Message</h2>
          <form class="space-y-6" action="https://formspree.io/f/your-form-id" method="POST">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="label">Full Name *</label>
                <input type="text" id="name" name="name" class="input-field" placeholder="Your name" required />
              </div>
              <div>
                <label for="email" class="label">Email Address *</label>
                <input type="email" id="email" name="email" class="input-field" placeholder="you@example.com" required />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="label">Phone / WhatsApp</label>
                <input type="tel" id="phone" name="phone" class="input-field" placeholder="+91 9xxxxxxxxx" />
              </div>
              <div>
                <label for="project-type" class="label">Project Type *</label>
                <select id="project-type" name="project_type" class="input-field" required>
                  <option value="">Select project type</option>
                  <option value="residential">Residential Interior Design</option>
                  <option value="commercial">Commercial Fit-out</option>
                  <option value="renovation">Renovation / Remodeling</option>
                  <option value="materials-only">Materials Purchase Only</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div>
              <label for="location" class="label">Project Location</label>
              <input type="text" id="location" name="location" class="input-field" placeholder="City, Area (e.g., Vizag, MVP Colony)" />
            </div>
            <div>
              <label for="budget" class="label">Estimated Budget</label>
              <select id="budget" name="budget" class="input-field">
                <option value="">Select budget range</option>
                <option value="under-5l">Under ₹5 Lakhs</option>
                <option value="5l-10l">₹5 - 10 Lakhs</option>
                <option value="10l-25l">₹10 - 25 Lakhs</option>
                <option value="25l-50l">₹25 - 50 Lakhs</option>
                <option value="50l-plus">₹50 Lakhs+</option>
                <option value="not-sure">Not sure yet</option>
              </select>
            </div>
            <div>
              <label for="message" class="label">Project Details *</label>
              <textarea id="message" name="message" rows="5" class="input-field resize-none" placeholder="Tell us about your project — style preferences, timeline, specific requirements, rooms to be designed, etc." required></textarea>
            </div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="updates" name="updates" class="mt-1 w-4 h-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-500" />
              <label for="updates" class="text-sm text-neutral-600">Send me design tips, material updates, and offers via email/WhatsApp</label>
            </div>
            <Button type="submit" variant="primary" class="w-full md:w-auto text-lg px-8 py-3">Submit & Get Free Quote</Button>
            <p class="text-sm text-neutral-500">We typically respond within 24 hours. For urgent queries, WhatsApp us directly.</p>
          </form>
        </Card>
      </div>

      <!-- Contact Info Cards -->
      <div class="space-y-6">
        <Card variant="default" padding="lg" class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Visit Our Showroom</h3>
          <address class="not-italic text-neutral-600 space-y-1">
            <p>8-141 Durga Nagar Layout</p>
            <p>Pendurthi, Vizag 531173</p>
            <p>Andhra Pradesh, India</p>
          </address>
          <a href="https://maps.google.com/?q=8-141+Durga+Nagar+Layout+Pendurthi+Vizag" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-primary-600 hover:text-primary-700 font-medium mt-4 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
            Get Directions
          </a>
        </Card>

        <Card variant="default" padding="lg" class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-secondary-100 flex items-center justify-center">
            <svg class="w-7 h-7 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Call / WhatsApp</h3>
          <div class="space-y-2 text-neutral-600">
            <a href="tel:+9183601314068" class="block hover:text-primary-600 transition-colors">+91 83601 31406</a>
            <a href="tel:+918872038393" class="block hover:text-primary-600 transition-colors">+91 88720 38393</a>
          </div>
          <div class="mt-4 flex items-center justify-center gap-3">
            <a href="https://wa.me/9183601314068" target="_blank" rel="noopener noreferrer" class="btn-accent text-sm px-4 py-2">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.273-.272.198-.967.9-.967 1.64 0 .694.42 1.026.547 1.14.134.12.766.798 1.33 1.755.548.937 1.08 2.073 1.293 2.376.213.302.26.413.36.492a.56.56 0 00.523-.112c.57-.792.898-1.737.96-2.02.063-.272.194-.557.225-.778.027-.208.009-.355-.099-.508zM12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.161.689-.223.689-.493 0-.243-.012-1.093-.012-2.01-2.782.605-3.369-1.342-3.369-1.342-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .27.18.587.688.493A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              WhatsApp Chat
            </a>
          </div>
        </Card>

        <Card variant="default" padding="lg" class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Email Us</h3>
          <a href="mailto:vrenterprisesvizag28@gmail.com" class="block text-neutral-600 hover:text-primary-600 transition-colors">vrenterprisesvizag28@gmail.com</a>
          <p class="text-sm text-neutral-500 mt-2">We reply within 24 hours</p>
        </Card>
      </div>
    </div>
  </Section>

  <!-- Quick Contact Bar -->
  <Section id="quick-contact" background="muted" padding="md">
    <div class="container flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-600 flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
        </div>
        <div>
          <p class="text-sm text-neutral-500">Have questions?</p>
          <p class="font-semibold text-neutral-900">Chat with us on WhatsApp</p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-center sm:items-center gap-4 w-full sm:w-auto">
        <a href="https://wa.me/9183601314068" target="_blank" rel="noopener noreferrer" class="btn-accent w-full sm:w-auto justify-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.273-.272.198-.967.9-.967 1.64 0 .694.42 1.026.547 1.14.134.12.766.798 1.33 1.755.548.937 1.08 2.073 1.293 2.376.213.302.26.413.36.492a.56.56 0 00.523-.112c.57-.792.898-1.737.96-2.02.063-.272.194-.557.225-.778.027-.208.009-.355-.099-.508zM12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.161.689-.223.689-.493 0-.243-.012-1.093-.012-2.01-2.782.605-3.369-1.342-3.369-1.342-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .27.18.587.688.493A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          WhatsApp Now
        </a>
        <a href="tel:+9183601314068" class="btn-secondary w-full sm:w-auto justify-center">Call Us</a>
      </div>
    </div>
  </Section>

  <!-- Map Placeholder -->
  <Section id="map" background="default" padding="none" class="h-[400px]">
    <div class="w-full h-full">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3837.123456789!2d83.2187654!3d17.7234567!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a3876543210%3A0x1234567890abcdef!2s8-141%20Durga%20Nagar%20Layout%2C%20Pendurthi%2C%20Visakhapatnam%2C%20Andhra%20Pradesh%20531173!5e0!3m2!1sen!2sin!4v1699999999999!5m2!1sen!2sin"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="VR Interiors Location Map"
      ></iframe>
    </div>
  </Section>

  <Footer slot="footer" />
</Layout>