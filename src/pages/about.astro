---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
---

<Layout title="About VR Interiors - Our Story, Team & Values" description="Learn about VR Interiors - founded in 2018, 15+ expert team members led by Founder Vivek Rao and Managing Director Govinda Rao. Interior design services and premium materials supplier in Vizag.">
  <Nav currentPage="/about" slot="header" />

  <!-- Hero -->
  <Section id="about-hero" background="gradient" padding="xl" narrow>
    <div class="text-center">
      <span class="badge-primary mb-6">Since 2018</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-neutral-900 mb-6">Building Spaces That Evolve With You</h1>
      <p class="text-xl md:text-2xl text-neutral-600 max-w-3xl mx-auto">From a small design studio to Vizag's trusted interior partner — our journey of transforming 500+ spaces across residential and commercial projects.</p>
    </div>
  </Section>

  <!-- Story -->
  <Section id="our-story" background="default" padding="lg">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <span class="badge-secondary mb-4">Our Journey</span>
        <h2 class="section-title text-left mb-6">From Vision to Reality</h2>
        <div class="space-y-4 text-lg text-neutral-700">
          <p>Founded in 2018 by <strong>Vivek Rao</strong> with a simple belief: as families grow and businesses evolve, their spaces should too. What started as a boutique interior design firm has grown into a full-service interior solutions provider with an in-house team of 15+ experts.</p>
          <p>In 2020, we expanded into materials supply — recognizing that design intent is only as good as the materials that bring it to life. Today, we stock Polygranite sheets, PVC, WPC, WPVC boards, and designer wallpapers, ensuring our clients get exactly what was specified in the design.</p>
          <p>Under the leadership of Managing Director <strong>Govinda Rao</strong>, we've delivered 500+ projects across Vizag and Andhra Pradesh — from luxury villas and modern apartments to corporate offices, showrooms, and restaurants.</p>
        </div>
        <Button variant="primary" href="/contact" class="mt-6">Start Your Project</Button>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl bg-neutral-100">
          <svg class="w-full h-full text-neutral-300" viewBox="0 0 400 300" aria-hidden="true">
            <rect width="400" height="300" fill="#f0f0f0"/>
            <rect x="40" y="60" width="320" height="200" rx="12" stroke="#007B83" stroke-width="3" fill="none"/>
            <path d="M40 160L120 220L280 100" stroke="#007B83" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <text x="200" y="280" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" fill="#999">Team workspace concept</text>
          </svg>
        </div>
        <div class="absolute -bottom-6 -right-6 md:-bottom-8 md:-right-8 bg-white rounded-xl shadow-lg p-4 md:p-6 min-w-[260px] border border-neutral-200">
          <p class="text-3xl font-bold text-primary-700">15+</p>
          <p class="text-neutral-600">Team Members</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Leadership Team -->
  <Section id="leadership" background="muted" padding="lg">
    <div class="section-header">
      <h2 class="section-title">Leadership Team</h2>
      <p class="section-subtitle">The visionaries behind VR Interiors</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {[
        { name: 'Vivek Rao', role: 'Founder & CEO', bio: 'Visionary designer with 15+ years of experience in residential and commercial interiors. Passionate about creating spaces that adapt to changing lifestyles.', image: '/team/vivek-rao.jpg' },
        { name: 'Govinda Rao', role: 'Managing Director', bio: 'Operations and strategy expert ensuring seamless project execution. Oversees materials procurement, vendor relations, and delivery timelines.', image: '/team/govinda-rao.jpg' },
      ].map(person => (
        <Card variant="horizontal" padding="none" class="bg-white">
          <div class="relative w-full md:w-1/2">
            <div class="aspect-square bg-neutral-100 flex items-center justify-center">
              <svg class="w-24 h-24 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
          </div>
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <h3 class="text-2xl font-bold text-neutral-900 mb-1">{person.name}</h3>
            <p class="text-primary-600 font-medium mb-4">{person.role}</p>
            <p class="text-neutral-600">{person.bio}</p>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Values -->
  <Section id="values" background="default" padding="lg">
    <div class="section-header">
      <h2 class="section-title">Our Values</h2>
      <p class="section-subtitle">The principles that guide every project we undertake</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { title: 'Design Integrity', desc: 'We design with honesty — no hidden costs, no compromises on quality, no shortcuts. What we promise is what we deliver.', icon: 'diamond' },
        { title: 'Material Mastery', desc: 'We stock what we specify. Our in-house material expertise means better sourcing, better pricing, and zero substitution surprises.', icon: 'cube' },
        { title: 'Client Partnership', desc: 'Your vision leads. We listen, advise, and execute — keeping you informed at every stage with weekly updates and transparent communication.', icon: 'handshake' },
      ].map((value, i) => (
        <Card variant="default" padding="lg" class="text-center group">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center group-hover:bg-primary-600 transition-colors duration-300">
            {value.icon === 'diamond' && <svg class="w-8 h-8 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>}
            {value.icon === 'cube' && <svg class="w-8 h-8 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>}
            {value.icon === 'handshake' && <svg class="w-8 h-8 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>}
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-2">{value.title}</h3>
          <p class="text-neutral-600">{value.desc}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Milestones -->
  <Section id="milestones" background="muted" padding="lg">
    <div class="section-header">
      <h2 class="section-title">Our Milestones</h2>
      <p class="section-subtitle">Key moments that shaped our journey</p>
    </div>
    <div class="max-w-3xl mx-auto">
      <ol class="relative">
        <li class="relative pl-10 pb-12 md:pb-16 before:content-[''] before:absolute before:left-3 before:top-0 before:h-full before:w-0.5 before:bg-primary-200 last:before:hidden">
          <div class="absolute left-0 top-1 w-7 h-7 rounded-full bg-primary-600 border-4 border-white shadow-lg flex items-center justify-center z-10" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          </div>
          <span class="badge-primary mb-3">2018</span>
          <h3 class="text-xl font-semibold text-neutral-900 mb-2">Founded</h3>
          <p class="text-neutral-600">Vivek Rao establishes VR Interiors as a boutique interior design studio in Vizag, focusing on residential projects.</p>
        </li>
        <li class="relative pl-10 pb-12 md:pb-16 before:content-[''] before:absolute before:left-3 before:top-0 before:h-full before:w-0.5 before:bg-primary-200 last:before:hidden">
          <div class="absolute left-0 top-1 w-7 h-7 rounded-full bg-primary-600 border-4 border-white shadow-lg flex items-center justify-center z-10" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          </div>
          <span class="badge-primary mb-3">2020</span>
          <h3 class="text-xl font-semibold text-neutral-900 mb-2">Materials Division Launched</h3>
          <p class="text-neutral-600">Expanded into Polygranite, PVC, WPC, and wallpaper supply to ensure design-to-execution quality control.</p>
        </li>
        <li class="relative pl-10 pb-12 md:pb-16 before:content-[''] before:absolute before:left-3 before:top-0 before:h-full before:w-0.5 before:bg-primary-200 last:before:hidden">
          <div class="absolute left-0 top-1 w-7 h-7 rounded-full bg-primary-600 border-4 border-white shadow-lg flex items-center justify-center z-10" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          </div>
          <span class="badge-primary mb-3">2022</span>
          <h3 class="text-xl font-semibold text-neutral-900 mb-2">Team Grows to 15+</h3>
          <p class="text-neutral-600">In-house designers, project managers, and craftsmen — full control over quality and timelines.</p>
        </li>
        <li class="relative pl-10">
          <div class="absolute left-0 top-1 w-7 h-7 rounded-full bg-secondary-600 border-4 border-white shadow-lg flex items-center justify-center z-10" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
          </div>
          <span class="badge-secondary mb-3">2024</span>
          <h3 class="text-xl font-semibold text-neutral-900 mb-2">500+ Projects Delivered</h3>
          <p class="text-neutral-600">Milestone achieved across residential, commercial, and renovation projects throughout Andhra Pradesh.</p>
        </li>
      </ol>
    </div>
  </Section>

  <!-- CTA -->
  <Section id="about-cta" background="primary" padding="lg" narrow>
    <div class="text-center text-white">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Let's Build Something Together</h2>
      <p class="text-primary-100 mb-8 max-w-2xl mx-auto">Whether you're renovating a home, fitting out an office, or sourcing materials for a project — we're ready to help.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button variant="secondary" href="/contact" class="w-full sm:w-auto border-white text-white hover:bg-white/10">Get a Quote</Button>
        <Button variant="ghost" href="/services" class="w-full sm:w-auto border-white/50 text-white hover:bg-white/10">Explore Services</Button>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
</Layout>