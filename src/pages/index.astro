---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
---

<Layout title="VR Interiors - Premium Interior Design & Materials in Vizag" description="VR Interiors provides expert interior design services and premium home interior materials including Polygranite sheets, PVC, WPC, WPVC, wallpapers and more. Serving Vizag and beyond.">
  <Nav currentPage="/" slot="header" />

  <!-- Hero Section -->
  <Hero
    title="AS WE evolve our home should too"
    subtitle="Vizag's trusted partner for complete interior solutions — from design consultation to premium materials supply. 15+ experts, 500+ projects delivered."
    ctaPrimary={{ label: 'Get a Quote', href: '/contact' }}
    ctaSecondary={{ label: 'Explore Materials', href: '/services#materials' }}
    badge="Est. 2018 • 15+ Team Members • 500+ Projects"
  />

  <!-- Services Overview -->
  <Section id="services" background="muted" padding="lg">
    <div class="section-header">
      <h2 class="section-title">Our Services & Materials</h2>
      <p class="section-subtitle">Complete interior solutions under one roof — design expertise meets material mastery</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <Card variant="default" padding="md" class="group">
        <div class="w-14 h-14 rounded-xl bg-primary-100 flex items-center justify-center mb-4 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-neutral-900 mb-2">Interior Design</h3>
        <p class="text-neutral-600">End-to-end residential & commercial design — space planning, 3D visualization, material selection, and project execution.</p>
      </Card>

      <Card variant="default" padding="md" class="group">
        <div class="w-14 h-14 rounded-xl bg-secondary-100 flex items-center justify-center mb-4 group-hover:bg-secondary-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7 text-secondary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-neutral-900 mb-2">Polygranite Sheets</h3>
        <p class="text-neutral-600">Premium polyester-based solid surface sheets — durable, seamless, and available in 50+ colors for countertops & wall cladding.</p>
      </Card>

      <Card variant="default" padding="md" class="group">
        <div class="w-14 h-14 rounded-xl bg-primary-100 flex items-center justify-center mb-4 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7 text-primary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-neutral-900 mb-2">PVC & WPC Panels</h3>
        <p class="text-neutral-600">Waterproof, termite-proof wall & ceiling panels — ideal for bathrooms, kitchens, and exterior applications.</p>
      </Card>

      <Card variant="default" padding="md" class="group">
        <div class="w-14 h-14 rounded-xl bg-secondary-100 flex items-center justify-center mb-4 group-hover:bg-secondary-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7 text-secondary-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-neutral-900 mb-2">WPVC & Wallpapers</h3>
        <p class="text-neutral-600">Wood-plastic composite boards for furniture & designer wallpapers — 200+ patterns for every style.</p>
      </Card>
    </div>
    <div class="text-center mt-12">
      <Button variant="secondary" href="/services" class="w-full sm:w-auto">View All Services & Materials</Button>
    </div>
  </Section>

  <!-- Featured Projects -->
  <Section id="projects" background="default" padding="lg">
    <div class="section-header">
      <h2 class="section-title">Featured Projects</h2>
      <p class="section-subtitle">A glimpse of spaces we've transformed across Vizag and Andhra Pradesh</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { title: 'Modern 3BHK Apartment', location: 'MVP Colony, Vizag', type: 'Residential', image: '/projects/project-1.jpg' },
        { title: 'Corporate Office Fit-out', location: 'Rushikonda, Vizag', type: 'Commercial', image: '/projects/project-2.jpg' },
        { title: 'Luxury Villa Renovation', location: 'Bheemili, Vizag', type: 'Renovation', image: '/projects/project-3.jpg' },
        { title: 'Showroom Interior', location: 'Gajuwaka, Vizag', type: 'Commercial', image: '/projects/project-4.jpg' },
        { title: 'Coastal Home Design', location: 'RK Beach, Vizag', type: 'Residential', image: '/projects/project-5.jpg' },
        { title: 'Restaurant Interior', location: 'Dwaraka Nagar, Vizag', type: 'Commercial', image: '/projects/project-6.jpg' },
      ].map(project => (
        <Card variant="image-top" href="/projects" image={{ src: project.image, alt: project.title }} badge={project.type} badgeVariant="primary">
          <div class="flex-1 flex flex-col">
            <h3 class="text-lg font-semibold text-neutral-900 mb-1">{project.title}</h3>
            <p class="text-sm text-neutral-500 mb-4 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              {project.location}
            </p>
            <span class="text-primary-600 font-medium text-sm hover:text-primary-700 transition-colors inline-flex items-center gap-1">
              View Project
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </span>
          </div>
        </Card>
      ))}
    </div>
    <div class="text-center mt-12">
      <Button variant="secondary" href="/projects" class="w-full sm:w-auto">View All Projects</Button>
    </div>
  </Section>

  <!-- Why Choose Us -->
  <Section id="why-us" background="muted" padding="lg">
    <div class="section-header">
      <h2 class="section-title">Why Choose VR Interiors?</h2>
      <p class="section-subtitle">Design expertise, material mastery, and a team that delivers on promises</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { icon: 'users', title: '15+ In-House Experts', desc: 'Designers, project managers, and craftsmen working together under one roof — no subcontracting surprises.' },
        { icon: 'shield', title: 'Design + Materials Unified', desc: 'We design with materials we stock. What you see in 3D is exactly what gets installed — same quality, same source.' },
        { icon: 'clock', title: 'On-Time Delivery Guarantee', desc: 'Project timelines locked in contract. Weekly progress updates. 95% on-time completion rate across 500+ projects.' },
      ].map((item, i) => (
        <Card variant="default" padding="lg" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            {item.icon === 'users' && (
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            )}
            {item.icon === 'shield' && (
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            )}
            {item.icon === 'clock' && (
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            )}
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-2">{item.title}</h3>
          <p class="text-neutral-600">{item.desc}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Testimonials -->
  <Section id="testimonials" background="default" padding="lg">
    <div class="section-header">
      <h2 class="section-title">What Our Clients Say</h2>
      <p class="section-subtitle">Trusted by homeowners, builders, and businesses across Vizag</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { quote: "VR Interiors transformed our 3BHK into a dream home. The design team understood our vision perfectly, and the material quality is exceptional. Highly recommended!", author: "Rajesh K.", role: "Homeowner, MVP Colony", rating: 5 },
        { quote: "Professional team, transparent pricing, and on-time delivery. They handled our office fit-out from design to installation. The Polygranite countertops are stunning.", author: "Priya Sharma", role: "Director, TechStart Solutions", rating: 5 },
        { quote: "Best material selection in Vizag. We sourced all PVC panels and wallpapers for our apartment project from them. Great rates and reliable supply.", author: "BuildCorp Constructions", role: "Builder Partner", rating: 5 },
      ].map(testimonial => (
        <Card variant="default" padding="lg" class="flex flex-col">
          <div class="flex gap-1 mb-4" aria-label={`${testimonial.rating} out of 5 stars`}>
            {[...Array(5)].map((_, i) => (
              <svg class="w-5 h-5 text-secondary-500 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <p class="text-neutral-700 mb-6 flex-1">"{testimonial.quote}"</p>
          <div class="border-t border-neutral-200 pt-4">
            <p class="font-semibold text-neutral-900">{testimonial.author}</p>
            <p class="text-sm text-neutral-500">{testimonial.role}</p>
          </div>
        </Card>
      ))}
    </div>
    <div class="text-center mt-8">
      <p class="text-neutral-600 mb-4">Based on 127+ Google Reviews — <a href="https://g.page/r/CQw..." target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline font-medium">Read all reviews</a></p>
    </div>
  </Section>

  <!-- Newsletter / CTA -->
  <Section id="contact-cta" background="gradient" padding="lg" narrow>
    <div class="text-center">
      <h2 class="section-title">Ready to Transform Your Space?</h2>
      <p class="section-subtitle mb-8">Get a free consultation and material samples delivered to your doorstep.</p>
      <form class="max-w-md mx-auto flex flex-col sm:flex-row gap-4" action="https://formspree.io/f/your-form-id" method="POST">
        <input type="email" name="email" placeholder="Your email address" class="input-field flex-1" required />
        <Button type="submit" variant="accent" class="w-full sm:w-auto">Subscribe & Get Quote</Button>
      </form>
      <p class="text-sm text-neutral-500 mt-4">No spam. Unsubscribe anytime. We'll also send you our material catalog.</p>
    </div>
  </Section>

  <Footer slot="footer" />
</Layout>